# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Voyage embeddings -- used by the ingest step and by EmbeddingRetriever at query
# time. Free tier at voyageai.com. Not needed to run the tests: every call is
# mocked, and pytest must pass with no keys set at all.
VOYAGE_API_KEY=

# Anthropic -- generation (claude-haiku-4-5-20251001) and the eval judge
# (claude-opus-5). Set a spend limit in the console; on a public endpoint that
# is the actual protection, not the in-process rate limiting.
ANTHROPIC_API_KEY=

# Only needed if the Anthropic key is identity-linked rather than a plain
# workspace key. A plain key needs no workspace header; leave this empty.
ANTHROPIC_WORKSPACE_ID=
